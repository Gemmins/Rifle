// Returns false for nil tables or hosts older than SQLite 3.7.16.
// Read individual fields only when the host version includes them.
init_api :: proc "contextless" (api: ^Api_Routines) -> bool {
	if api == nil || api.libversion_number == nil { return false }
	version := api.libversion_number()
	if version < 3007016 { return false }
	aggregate_context = api.aggregate_context
	aggregate_count = api.aggregate_count
	bind_blob = api.bind_blob
	bind_double = api.bind_double
	bind_int = api.bind_int
	bind_int64 = api.bind_int64
	bind_null = api.bind_null
	bind_parameter_count = api.bind_parameter_count
	bind_parameter_index = api.bind_parameter_index
	bind_parameter_name = api.bind_parameter_name
	bind_text = api.bind_text
	bind_text16 = api.bind_text16
	bind_value = api.bind_value
	busy_handler = api.busy_handler
	busy_timeout = api.busy_timeout
	changes = api.changes
	close = api.close
	collation_needed = api.collation_needed
	collation_needed16 = api.collation_needed16
	column_blob = api.column_blob
	column_bytes = api.column_bytes
	column_bytes16 = api.column_bytes16
	column_count = api.column_count
	column_database_name = api.column_database_name
	column_database_name16 = api.column_database_name16
	column_decltype = api.column_decltype
	column_decltype16 = api.column_decltype16
	column_double = api.column_double
	column_int = api.column_int
	column_int64 = api.column_int64
	column_name = api.column_name
	column_name16 = api.column_name16
	column_origin_name = api.column_origin_name
	column_origin_name16 = api.column_origin_name16
	column_table_name = api.column_table_name
	column_table_name16 = api.column_table_name16
	column_text = api.column_text
	column_text16 = api.column_text16
	column_type = api.column_type
	column_value = api.column_value
	commit_hook = api.commit_hook
	complete = api.complete
	complete16 = api.complete16
	create_collation = api.create_collation
	create_collation16 = api.create_collation16
	create_function = api.create_function
	create_function16 = api.create_function16
	create_module = api.create_module
	create_module_v2 = api.create_module_v2
	data_count = api.data_count
	db_handle = api.db_handle
	declare_vtab = api.declare_vtab
	enable_shared_cache = api.enable_shared_cache
	errcode = api.errcode
	errmsg = api.errmsg
	errmsg16 = api.errmsg16
	exec = api.exec
	expired = api.expired
	finalize = api.finalize
	free = api.free
	free_table = api.free_table
	get_autocommit = api.get_autocommit
	get_auxdata = api.get_auxdata
	get_table = api.get_table
	global_recover = api.global_recover
	interrupt = api.interruptx
	last_insert_rowid = api.last_insert_rowid
	libversion = api.libversion
	libversion_number = api.libversion_number
	malloc = api.malloc
	mprintf = api.mprintf
	open = api.open
	open16 = api.open16
	prepare = api.prepare
	prepare16 = api.prepare16
	prepare_v2 = api.prepare_v2
	prepare16_v2 = api.prepare16_v2
